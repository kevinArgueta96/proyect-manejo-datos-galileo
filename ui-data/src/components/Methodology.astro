---
import data from "../data/results.json";
const { target, featureEngineering, splitStrategy } = data;
---

<section id="metodologia" class="section">
  <div class="container">
    <h2 class="section-title animate-on-scroll">Metodologia</h2>

    <div class="grid-3">
      <!-- Card 1: Variable Objetivo -->
      <div
        class="card method-card animate-on-scroll"
        data-delay="0s"
        style="--card-color: var(--cyan); border-top: 3px solid var(--cyan)"
      >
        <div class="method-header">
          <span class="method-icon">&#x1F3AF;</span>
          <h3 class="method-title" style="color: var(--cyan)">Variable Objetivo</h3>
        </div>
        <p class="method-formula">
          <code>mental_health_risk</code>
          <span class="target-tag">target inicial</span>
        </p>
        <p class="method-desc">Promedio de stress, anxiety y addiction</p>
        <div class="threshold-grid">
          <div class="threshold-item">
            <span class="badge badge-green">Bajo</span>
            <span class="threshold-val">{target.thresholds.Bajo}</span>
          </div>
          <div class="threshold-item">
            <span class="badge badge-amber">Medio</span>
            <span class="threshold-val">{target.thresholds.Medio}</span>
          </div>
          <div class="threshold-item">
            <span class="badge badge-red">Alto</span>
            <span class="threshold-val">{target.thresholds.Alto}</span>
          </div>
        </div>
        <p class="target-note">
          ⚠️ El EDA reveló que este target (un promedio) estaba sesgado a 'Medio'.
          El modelo final usa <code>depression_label</code> — ver
          <a href="#final">Modelo Final</a>.
        </p>
      </div>

      <!-- Card 2: Feature Engineering -->
      <div
        class="card method-card animate-on-scroll"
        data-delay="0.15s"
        style="--card-color: var(--green); border-top: 3px solid var(--green)"
      >
        <div class="method-header">
          <span class="method-icon">&#x1F527;</span>
          <h3 class="method-title" style="color: var(--green)">Feature Engineering</h3>
        </div>
        <div class="code-block">
          {featureEngineering.created.map((f) => (
            <div class="code-line">
              <span class="code-name">{f.name}</span>
              <span class="code-eq">=</span>
              <span class="code-val">{f.formula}</span>
            </div>
          ))}
        </div>
        <div class="leakage-section">
          <span class="leakage-label">Leakage removido</span>
          <div class="leakage-tags">
            {featureEngineering.leakageRemoved.map((col) => (
              <span class="leakage-tag">{col}</span>
            ))}
          </div>
        </div>
      </div>

      <!-- Card 3: Division de Datos -->
      <div
        class="card method-card animate-on-scroll"
        data-delay="0.3s"
        style="--card-color: var(--amber); border-top: 3px solid var(--amber)"
      >
        <div class="method-header">
          <span class="method-icon">&#x2702;&#xFE0F;</span>
          <h3 class="method-title" style="color: var(--amber)">Division de Datos</h3>
        </div>
        <div class="split-visual">
          <div class="split-bar">
            <div class="split-train">80%</div>
            <div class="split-test">20%</div>
          </div>
          <div class="split-labels">
            <span>Train (960)</span>
            <span>Test (240)</span>
          </div>
        </div>
        <ul class="method-list">
          <li>Stratified split</li>
          <li>Random state: {splitStrategy.randomState}</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .section {
    padding: 3rem 0;
  }

  .method-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .method-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .method-icon {
    font-size: 1.35rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .method-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
  }

  /* Card 1: Target */
  .method-formula code {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--cyan);
    background: color-mix(in srgb, var(--cyan) 8%, transparent);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .method-desc {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .target-tag {
    display: inline-block;
    margin-left: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--amber);
    background: color-mix(in srgb, var(--amber) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--amber) 30%, var(--border));
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    vertical-align: middle;
  }

  .target-note {
    margin-top: 0.9rem;
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--muted);
    border-top: 1px dashed var(--border);
    padding-top: 0.6rem;
  }
  .target-note code {
    font-family: var(--font-mono);
    color: var(--green);
  }
  .target-note a { color: var(--cyan); text-decoration: underline; }

  .threshold-grid {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .threshold-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.3rem 0;
  }

  .threshold-val {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text);
  }

  /* Card 2: Code Block */
  .code-block {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
  }

  .code-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    align-items: baseline;
  }

  .code-name {
    color: var(--green);
    white-space: nowrap;
  }

  .code-eq {
    color: var(--muted);
  }

  .code-val {
    color: color-mix(in srgb, var(--text) 70%, transparent);
    word-break: break-word;
  }

  .leakage-section {
    border-top: 1px solid var(--border);
    padding-top: 0.65rem;
    margin-top: 0.25rem;
  }

  .leakage-label {
    font-size: 0.7rem;
    color: var(--red);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    display: block;
    margin-bottom: 0.4rem;
    font-weight: 600;
  }

  .leakage-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .leakage-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--red);
    background: color-mix(in srgb, var(--red) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--red) 25%, transparent);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    text-decoration: line-through;
  }

  /* Card 3: Split */
  .split-visual {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .split-bar {
    display: flex;
    height: 28px;
    border-radius: 6px;
    overflow: hidden;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .split-train {
    flex: 4;
    background: color-mix(in srgb, var(--amber) 25%, transparent);
    color: var(--amber);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .split-test {
    flex: 1;
    background: color-mix(in srgb, var(--cyan) 20%, transparent);
    color: var(--cyan);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .split-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .method-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .method-list li {
    font-size: 0.85rem;
    color: var(--text);
    padding-left: 1rem;
    position: relative;
    line-height: 1.5;
  }

  .method-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--card-color);
    box-shadow: 0 0 6px var(--card-color);
  }
</style>
