---
import data from "../data/results.json";
const { toolbox } = data;
const { intro, anomaly, anova, rfe, conclusion } = toolbox;
const maxF = Math.max(...anova.map((a) => a.fscore));
---

<section id="toolbox" class="section">
  <div class="container">
    <h2 class="section-title animate-on-scroll">Caja de Herramientas</h2>
    <p class="section-intro animate-on-scroll">{intro}</p>

    <div class="grid-2">
      <!-- Anomaly detection -->
      <div class="card animate-on-scroll" data-delay="0s">
        <h3 class="card-title">Detección de anomalías</h3>
        <div class="anomaly-row">
          <div class="anomaly-stat" style={`border-color: ${anomaly.zscore.color}`}>
            <span class="anomaly-num" style={`color: ${anomaly.zscore.color}`}>{anomaly.zscore.outliers}</span>
            <span class="anomaly-method">{anomaly.zscore.method}</span>
          </div>
          <div class="anomaly-stat" style={`border-color: ${anomaly.isolationForest.color}`}>
            <span class="anomaly-num" style={`color: ${anomaly.isolationForest.color}`}>{anomaly.isolationForest.outliers}</span>
            <span class="anomaly-method">{anomaly.isolationForest.method}</span>
          </div>
        </div>
        <p class="hint">{anomaly.note}</p>
      </div>

      <!-- ANOVA ranking -->
      <div class="card animate-on-scroll" data-delay="0.15s">
        <h3 class="card-title">Ranking de variables — ANOVA F-score</h3>
        <div class="anova-list">
          {anova.map((a) => (
            <div class="anova-item">
              <span class="anova-name">{a.feature}</span>
              <div class="anova-bar-track">
                <div class="anova-bar" style={`width: ${(a.fscore / maxF) * 100}%`}></div>
              </div>
              <span class="anova-val">{a.fscore.toFixed(2)}</span>
            </div>
          ))}
        </div>
        <p class="hint">Solo <code>depression_label</code> destaca; el resto ≈ 1–2 → señal débil.</p>
      </div>
    </div>

    <!-- RFE feature selection -->
    <div class="card animate-on-scroll" data-delay="0s" style="margin-top:1.5rem">
      <h3 class="card-title">Selección de variables (RFE) — {rfe.selected.length} de {rfe.totalFeatures}</h3>
      <div class="rfe-grid">
        <div>
          <div class="chips">
            {rfe.selected.map((f) => (
              <span class="chip chip-on">{f}</span>
            ))}
          </div>
        </div>
        <div class="table-scroll">
          <table>
            <thead>
              <tr><th>Configuración</th><th>Acc</th><th>Bal. Acc</th><th>F1-macro</th></tr>
            </thead>
            <tbody>
              {rfe.comparison.map((c) => (
                <tr class={c.best ? "row-best" : ""}>
                  <td>{c.config}{c.best && <span class="badge badge-green best-badge">Mejor</span>}</td>
                  <td class="acc-val">{(c.accuracy * 100).toFixed(1)}%</td>
                  <td class="acc-val">{(c.balancedAccuracy * 100).toFixed(1)}%</td>
                  <td class="acc-val">{c.f1Macro.toFixed(3)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <p class="insight-text" style="margin-top:1rem">{conclusion}</p>
    </div>
  </div>
</section>

<style>
  .section { padding: 3rem 0; }

  .section-intro { color: var(--muted); max-width: 60ch; line-height: 1.6; margin-bottom: 2rem; font-size: 0.95rem; }

  .card-title {
    font-family: var(--font-display);
    font-size: 1rem; font-weight: 600; color: var(--muted);
    margin-bottom: 1.25rem; text-transform: uppercase; letter-spacing: 0.04em;
  }

  .hint { font-size: 0.75rem; color: var(--muted); margin-top: 1rem; line-height: 1.5; }
  .hint code, .insight-text code { font-family: var(--font-mono); color: var(--cyan); }

  /* Anomaly */
  .anomaly-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .anomaly-stat {
    border: 1px solid var(--border);
    border-left-width: 3px;
    border-radius: 8px;
    padding: 1rem;
    display: flex; flex-direction: column; gap: 0.35rem;
  }
  .anomaly-num { font-family: var(--font-mono); font-size: 2rem; font-weight: 800; line-height: 1; }
  .anomaly-method { font-size: 0.78rem; color: var(--muted); }

  /* ANOVA */
  .anova-list { display: flex; flex-direction: column; gap: 0.55rem; }
  .anova-item { display: grid; grid-template-columns: 1fr 2fr auto; align-items: center; gap: 0.6rem; }
  .anova-name { font-family: var(--font-mono); font-size: 0.72rem; color: var(--text); }
  .anova-bar-track { background: var(--border); border-radius: 4px; height: 8px; overflow: hidden; }
  .anova-bar { height: 100%; background: var(--cyan); border-radius: 4px; box-shadow: 0 0 6px rgba(0,240,255,0.4); }
  .anova-val { font-family: var(--font-mono); font-size: 0.72rem; color: var(--cyan); font-variant-numeric: tabular-nums; }

  /* RFE */
  .rfe-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; align-items: start; }
  @media (max-width: 768px) { .rfe-grid, .anomaly-row { grid-template-columns: 1fr; } }

  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    font-family: var(--font-mono); font-size: 0.72rem;
    border-radius: 6px; padding: 0.3rem 0.6rem;
  }
  .chip-on {
    background: color-mix(in srgb, var(--green) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--green) 35%, var(--border));
    color: var(--text);
  }

  .table-scroll { overflow-x: auto; }
  .row-best { background: color-mix(in srgb, var(--green) 8%, transparent); }
  .best-badge { margin-left: 0.5rem; font-size: 0.65rem; vertical-align: middle; }
  .acc-val { font-family: var(--font-mono); font-weight: 700; font-size: 0.82rem; font-variant-numeric: tabular-nums; color: var(--cyan); }

  .insight-text { font-size: 0.9rem; line-height: 1.7; color: var(--text); }
</style>
