---
import data from "../data/results.json";
const { targetReeval } = data;
const { intro, distributions, comparison, comparisonNote, control, controlHighlight, conclusion } = targetReeval;
---

<section id="target" class="section">
  <div class="container">
    <h2 class="section-title animate-on-scroll">Reevaluación del Target</h2>
    <p class="section-intro animate-on-scroll">{intro}</p>

    <!-- Distribution comparison -->
    <div class="card animate-on-scroll" data-delay="0s" style="margin-bottom:1.5rem">
      <h3 class="card-title">Distribución del target: original vs. nuevo</h3>
      <div class="dist-grid">
        <div><canvas id="distChart"></canvas></div>
        <div class="dist-side">
          <div class="dist-block">
            <span class="dist-tag" style="color:var(--red)">Original (promedio + umbrales)</span>
            <span class="dist-val">254 / <strong>731</strong> / 215</span>
            <span class="dist-desc">Sesgado: 60.9% en 'Medio'</span>
          </div>
          <div class="dist-block">
            <span class="dist-tag" style="color:var(--green)">Nuevo (percentiles 33/33/33)</span>
            <span class="dist-val">484 / 362 / 354</span>
            <span class="dist-desc">Balanceado por diseño</span>
          </div>
        </div>
      </div>
    </div>

    <div class="grid-2">
      <!-- Target redefinition -->
      <div class="card animate-on-scroll" data-delay="0s">
        <h3 class="card-title">Umbrales fijos vs. percentiles</h3>
        <canvas id="targetChart"></canvas>
        <div class="table-scroll" style="margin-top:1rem">
          <table>
            <thead>
              <tr><th>Target</th><th>Distribución</th><th>Bal. Acc</th><th>F1-macro</th></tr>
            </thead>
            <tbody>
              {comparison.map((c) => (
                <tr class={c.best ? "row-best" : ""}>
                  <td>{c.target}{c.best && <span class="badge badge-green best-badge">Mejor</span>}</td>
                  <td class="muted">{c.distribution}</td>
                  <td class="acc-val">{c.balancedAccuracy.toFixed(2)}</td>
                  <td class="acc-val">{c.f1Macro.toFixed(2)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="hint">{comparisonNote}</p>
      </div>

      <!-- Control / bridge to final model -->
      <div class="card animate-on-scroll control-card" data-delay="0.15s">
        <h3 class="card-title">¿Dónde vive la señal?</h3>
        <div class="leak-warn">Experimento de control — diagnóstico, no modelo final</div>
        <div class="big-stat">
          <span class="big-num">{(controlHighlight.accuracy * 100).toFixed(0)}%</span>
          <span class="big-label">{controlHighlight.label}</span>
        </div>
        <div class="table-scroll">
          <table>
            <thead>
              <tr><th>Features (mismo target)</th><th>Acc</th><th>Bal. Acc</th><th>F1-macro</th></tr>
            </thead>
            <tbody>
              {control.rows.map((r) => (
                <tr class={r.leak ? "row-leak" : ""}>
                  <td>{r.features}</td>
                  <td class="acc-val">{r.accuracy.toFixed(2)}</td>
                  <td class="acc-val">{r.balancedAccuracy.toFixed(2)}</td>
                  <td class="acc-val">{r.f1Macro.toFixed(2)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="hint">{control.note}</p>
      </div>
    </div>

    <div class="card insight-card animate-on-scroll" data-delay="0s" style="margin-top:1.5rem">
      <h3 class="card-title">Del diagnóstico al modelo</h3>
      <p class="insight-text">{conclusion}</p>
      <a href="#final" class="bridge-link">Ver Modelo Final →</a>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const distCtx = document.getElementById("distChart");
    if (distCtx && typeof Chart !== "undefined") {
      new Chart(distCtx, {
        type: "bar",
        data: {
          labels: ["Bajo", "Medio", "Alto"],
          datasets: [
            { label: "Original (promedio)", data: [254, 731, 215], backgroundColor: "rgba(255,107,107,0.7)", borderRadius: 6 },
            { label: "Percentiles 33/33/33", data: [484, 362, 354], backgroundColor: "rgba(74,222,128,0.75)", borderRadius: 6 },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          animation: { duration: 1400, easing: "easeOutQuart" },
          scales: {
            y: { min: 0, max: 800, grid: { color: "#1e1e2e" }, ticks: { color: "#888" } },
            x: { grid: { display: false }, ticks: { color: "#e0e0e0", font: { weight: "600", family: "Satoshi, Inter, sans-serif" } } },
          },
          plugins: {
            legend: { labels: { color: "#e0e0e0", font: { family: "Satoshi, Inter, sans-serif" } } },
            tooltip: {
              backgroundColor: "#1e1e2e", titleColor: "#e0e0e0", bodyColor: "#e0e0e0",
              borderColor: "#00f0ff", borderWidth: 1, padding: 12, cornerRadius: 8,
              callbacks: { label: function(c) { return c.dataset.label + ": " + c.raw + " casos"; } },
            },
          },
        },
      });
    }

    const ctx = document.getElementById("targetChart");
    if (!ctx || typeof Chart === "undefined") return;
    new Chart(ctx, {
      type: "bar",
      data: {
        labels: ["Umbrales fijos", "Percentiles 33/33/33"],
        datasets: [
          { label: "Balanced Acc.", data: [0.31, 0.39], backgroundColor: "rgba(92,133,214,0.75)", borderRadius: 6 },
          { label: "F1-macro", data: [0.31, 0.39], backgroundColor: "rgba(74,222,128,0.75)", borderRadius: 6 },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: true,
        animation: { duration: 1400, easing: "easeOutQuart" },
        scales: {
          y: {
            min: 0, max: 0.5,
            grid: { color: "#1e1e2e" },
            ticks: { color: "#888" },
          },
          x: { grid: { display: false }, ticks: { color: "#e0e0e0", font: { weight: "600", family: "Satoshi, Inter, sans-serif" } } },
        },
        plugins: {
          legend: { labels: { color: "#e0e0e0", font: { family: "Satoshi, Inter, sans-serif" } } },
          annotation: {},
          tooltip: {
            backgroundColor: "#1e1e2e", titleColor: "#e0e0e0", bodyColor: "#e0e0e0",
            borderColor: "#00f0ff", borderWidth: 1, padding: 12, cornerRadius: 8,
          },
        },
      },
    });
  });
</script>

<style>
  .section { padding: 3rem 0; }
  .section-intro { color: var(--muted); max-width: 64ch; line-height: 1.6; margin-bottom: 2rem; font-size: 0.95rem; }

  .card-title {
    font-family: var(--font-display); font-size: 1rem; font-weight: 600; color: var(--muted);
    margin-bottom: 1.25rem; text-transform: uppercase; letter-spacing: 0.04em;
  }

  .hint { font-size: 0.75rem; color: var(--muted); margin-top: 1rem; line-height: 1.5; }

  .table-scroll { overflow-x: auto; }
  .muted { color: var(--muted); font-size: 0.82rem; font-family: var(--font-mono); }
  .acc-val { font-family: var(--font-mono); font-weight: 700; font-size: 0.82rem; font-variant-numeric: tabular-nums; color: var(--cyan); }

  .row-best { background: color-mix(in srgb, var(--green) 8%, transparent); }
  .best-badge { margin-left: 0.5rem; font-size: 0.65rem; vertical-align: middle; }

  .control-card { border-left: 3px solid var(--amber); }
  .leak-warn {
    font-size: 0.78rem; color: var(--amber); font-weight: 600;
    background: color-mix(in srgb, var(--amber) 10%, transparent);
    border-radius: 6px; padding: 0.5rem 0.75rem; margin-bottom: 1rem;
  }
  .row-leak { background: color-mix(in srgb, var(--amber) 8%, transparent); }
  .row-leak .acc-val { color: var(--amber); }
  .bridge-link {
    display: inline-block; margin-top: 1rem;
    font-family: var(--font-display); font-weight: 700; font-size: 0.85rem;
    color: var(--green); text-decoration: none;
  }
  .bridge-link:hover { text-decoration: underline; }

  .dist-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(260px, 1fr);
    gap: 2rem;
    align-items: center;
  }
  @media (max-width: 820px) { .dist-grid { grid-template-columns: 1fr; gap: 1.5rem; } }
  .dist-side { display: flex; flex-direction: column; gap: 1.25rem; }
  .dist-block {
    display: flex; flex-direction: column; gap: 0.3rem;
    padding-left: 0.9rem;
    border-left: 3px solid var(--border);
  }
  .dist-block:first-child { border-left-color: var(--red); }
  .dist-block:last-child { border-left-color: var(--green); }
  .dist-tag { font-family: var(--font-display); font-size: 0.8rem; font-weight: 700; line-height: 1.3; }
  .dist-val { font-family: var(--font-mono); font-size: 1.15rem; color: var(--text); letter-spacing: 0.02em; white-space: nowrap; }
  .dist-desc { font-size: 0.78rem; color: var(--muted); line-height: 1.4; }

  .big-stat {
    display: flex; flex-direction: column; align-items: center;
    gap: 0.25rem; padding: 1rem; margin-bottom: 1rem;
    background: color-mix(in srgb, var(--amber) 6%, transparent);
    border-radius: 8px;
  }
  .big-num { font-family: var(--font-mono); font-size: 2.5rem; font-weight: 800; color: var(--amber); line-height: 1; }
  .big-label { font-size: 0.75rem; color: var(--muted); text-align: center; }

  .insight-card { border-left: 3px solid var(--amber); }
  .insight-text { font-size: 0.92rem; line-height: 1.7; color: var(--text); }
</style>
