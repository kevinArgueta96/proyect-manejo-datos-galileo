---
const inputNodes = [
  "social_media_hrs",
  "sleep_hours",
  "screen_time",
  "physical_activity",
  "depression_label",
  "age",
];

const hiddenLayer1 = 8;
const hiddenLayer2 = 6;

const outputNodes = [
  { label: "Bajo", color: "#4ade80" },
  { label: "Medio", color: "#fbbf24" },
  { label: "Alto", color: "#ff6b6b" },
];
---

<section id="neural-net" class="section">
  <div class="container">
    <h2 class="section-title animate-on-scroll">Red Neuronal — Visualizacion Conceptual</h2>
    <p class="nn-subtitle animate-on-scroll" data-delay="0.05s">
      Asi funcionaria una red neuronal para esta tarea de clasificacion. Los nodos se iluminan al pasar el mouse.
    </p>

    <div class="nn-wrapper animate-on-scroll" data-delay="0.1s">
      <svg
        id="nnSvg"
        class="nn-svg"
        viewBox="0 0 900 420"
        preserveAspectRatio="xMidYMid meet"
      >
        <!-- Connections drawn by JS -->
        <g id="nnEdges" class="nn-edges"></g>

        <!-- Layer labels -->
        <text x="80" y="25" class="layer-label">Input (6)</text>
        <text x="320" y="25" class="layer-label">Hidden 1 (8)</text>
        <text x="540" y="25" class="layer-label">Hidden 2 (6)</text>
        <text x="770" y="25" class="layer-label">Output (3)</text>

        <!-- Input nodes -->
        {inputNodes.map((name, i) => {
          const y = 60 + i * 58;
          return (
            <g class="nn-node input-node" data-layer="input" data-index={i}>
              <circle cx="80" cy={y} r="16" />
              <text x="80" y={y + 1} class="node-label">{i + 1}</text>
              <text x="10" y={y + 1} class="input-label">{name}</text>
            </g>
          );
        })}

        <!-- Hidden layer 1 -->
        {Array.from({ length: hiddenLayer1 }, (_, i) => {
          const y = 42 + i * 46;
          return (
            <g class="nn-node hidden-node" data-layer="h1" data-index={i}>
              <circle cx="340" cy={y} r="14" />
              <text x="340" y={y + 1} class="node-label">{i + 1}</text>
            </g>
          );
        })}

        <!-- Hidden layer 2 -->
        {Array.from({ length: hiddenLayer2 }, (_, i) => {
          const y = 68 + i * 54;
          return (
            <g class="nn-node hidden-node" data-layer="h2" data-index={i}>
              <circle cx="560" cy={y} r="14" />
              <text x="560" y={y + 1} class="node-label">{i + 1}</text>
            </g>
          );
        })}

        <!-- Output nodes -->
        {outputNodes.map((node, i) => {
          const y = 130 + i * 80;
          return (
            <g class="nn-node output-node" data-layer="output" data-index={i}>
              <circle cx="790" cy={y} r="20" style={`--node-color: ${node.color}`} />
              <text x="790" y={y + 1} class="node-label output-label">{node.label}</text>
            </g>
          );
        })}
      </svg>
    </div>

    <!-- Architecture note -->
    <div class="grid-3 nn-info">
      <div class="card nn-info-card animate-on-scroll" data-delay="0.2s">
        <span class="nn-info-title" style="color: var(--cyan)">Arquitectura Real</span>
        <p class="nn-info-text">13 → 64 → 32 → 3 neuronas. MLPClassifier con ReLU, early stopping y StandardScaler en pipeline.</p>
      </div>
      <div class="card nn-info-card animate-on-scroll" data-delay="0.28s">
        <span class="nn-info-title" style="color: var(--green)">Mejor Modelo: 60.00%</span>
        <p class="nn-info-text">Supero a Random Forest (58.33%) como mejor modelo. CV: 60.73% ± 1.12% confirma estabilidad.</p>
      </div>
      <div class="card nn-info-card animate-on-scroll" data-delay="0.36s">
        <span class="nn-info-title" style="color: var(--amber)">Ventaja</span>
        <p class="nn-info-text">Captura relaciones no lineales entre features sin necesidad de feature engineering manual.</p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const svg = document.getElementById("nnSvg");
    const edgesG = document.getElementById("nnEdges");
    if (!svg || !edgesG) return;

    // Layer positions
    const layers = [
      { x: 80, count: 6, startY: 60, gap: 58 },   // input
      { x: 340, count: 8, startY: 42, gap: 46 },  // h1
      { x: 560, count: 6, startY: 68, gap: 54 },  // h2
      { x: 790, count: 3, startY: 130, gap: 80 },  // output
    ];

    function getY(layer, idx) {
      return layers[layer].startY + idx * layers[layer].gap;
    }

    // Draw edges between consecutive layers
    for (var l = 0; l < layers.length - 1; l++) {
      for (var i = 0; i < layers[l].count; i++) {
        for (var j = 0; j < layers[l + 1].count; j++) {
          var line = document.createElementNS("http://www.w3.org/2000/svg", "line");
          line.setAttribute("x1", layers[l].x);
          line.setAttribute("y1", getY(l, i));
          line.setAttribute("x2", layers[l + 1].x);
          line.setAttribute("y2", getY(l + 1, j));
          line.setAttribute("data-from-layer", l);
          line.setAttribute("data-from-idx", i);
          line.setAttribute("data-to-layer", l + 1);
          line.setAttribute("data-to-idx", j);
          edgesG.appendChild(line);
        }
      }
    }

    // Hover: highlight connected edges
    var allNodes = svg.querySelectorAll(".nn-node");
    var allEdges = edgesG.querySelectorAll("line");

    allNodes.forEach(function(node) {
      node.addEventListener("mouseenter", function() {
        var layerMap = { input: 0, h1: 1, h2: 2, output: 3 };
        var layerIdx = layerMap[node.dataset.layer];
        var nodeIdx = parseInt(node.dataset.index);
        allEdges.forEach(function(edge) {
          var fromL = parseInt(edge.dataset.fromLayer);
          var fromI = parseInt(edge.dataset.fromIdx);
          var toL = parseInt(edge.dataset.toLayer);
          var toI = parseInt(edge.dataset.toIdx);
          if ((fromL === layerIdx && fromI === nodeIdx) || (toL === layerIdx && toI === nodeIdx)) {
            edge.classList.add("active");
          }
        });
        node.classList.add("active");
      });
      node.addEventListener("mouseleave", function() {
        allEdges.forEach(function(e) { e.classList.remove("active"); });
        node.classList.remove("active");
      });
    });

    // Pulse animation on load
    var delay = 0;
    allNodes.forEach(function(node) {
      setTimeout(function() { node.classList.add("appeared"); }, delay);
      delay += 40;
    });
  });
</script>

<style>
  .section {
    padding: 3rem 0;
  }

  .nn-subtitle {
    font-size: 0.9rem;
    color: var(--muted);
    margin-top: -1.5rem;
    margin-bottom: 2rem;
    padding-left: 1rem;
  }

  .nn-wrapper {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    overflow-x: auto;
  }

  .nn-svg {
    width: 100%;
    max-height: 440px;
  }

  /* Layer labels */
  .layer-label {
    fill: var(--muted);
    font-size: 11px;
    font-family: var(--font-display);
    font-weight: 600;
    text-anchor: middle;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Edges */
  .nn-edges line {
    stroke: var(--border);
    stroke-width: 0.6;
    transition: stroke 0.25s, stroke-width 0.25s, opacity 0.25s;
  }

  .nn-edges line.active {
    stroke: var(--cyan);
    stroke-width: 1.8;
    opacity: 1;
    filter: drop-shadow(0 0 3px rgba(0, 240, 255, 0.4));
  }

  /* Nodes */
  .nn-node circle {
    fill: var(--bg);
    stroke: var(--muted);
    stroke-width: 1.5;
    transition: stroke 0.25s, fill 0.25s, filter 0.25s, transform 0.25s;
    cursor: pointer;
  }

  .nn-node {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .nn-node.appeared {
    opacity: 1;
  }

  .nn-node.active circle,
  .nn-node:hover circle {
    stroke: var(--cyan);
    fill: color-mix(in srgb, var(--cyan) 15%, var(--bg));
    filter: drop-shadow(0 0 6px rgba(0, 240, 255, 0.35));
  }

  .output-node circle {
    stroke: var(--node-color, var(--muted));
    stroke-width: 2;
  }

  .output-node.active circle,
  .output-node:hover circle {
    stroke: var(--node-color);
    fill: color-mix(in srgb, var(--node-color) 20%, var(--bg));
    filter: drop-shadow(0 0 8px var(--node-color));
  }

  .node-label {
    fill: var(--muted);
    font-size: 9px;
    font-family: var(--font-mono);
    text-anchor: middle;
    dominant-baseline: central;
    pointer-events: none;
  }

  .output-label {
    fill: var(--text);
    font-size: 10px;
    font-family: var(--font-display);
    font-weight: 700;
  }

  .input-label {
    fill: var(--muted);
    font-size: 8px;
    font-family: var(--font-mono);
    text-anchor: end;
    dominant-baseline: central;
  }

  /* Info cards */
  .nn-info {
    margin-top: 1.5rem;
  }

  .nn-info-card {
    padding: 1rem 1.25rem;
  }

  .nn-info-title {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    display: block;
    margin-bottom: 0.35rem;
  }

  .nn-info-text {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.55;
  }

  @media (max-width: 768px) {
    .nn-svg {
      max-height: 300px;
    }

    .input-label {
      display: none;
    }
  }
</style>
