---
const inputNodes = [
  "sm_sleep_ratio",
  "academic_perf",
  "act_sleep_ratio",
  "sleep_hours",
  "total_screen",
  "social_media_h",
  "screen_b_sleep",
  "physical_act",
  "age",
  "depression_lbl",
];

const hiddenLayer1 = 8;
const hiddenLayer2 = 6;

const outputNodes = [
  { label: "Bajo", color: "#4ade80" },
  { label: "Medio", color: "#fbbf24" },
  { label: "Alto", color: "#ff6b6b" },
];
---

<section id="neural-net" class="section">
  <div class="container">
    <h2 class="section-title animate-on-scroll">Red Neuronal — Visualizacion</h2>
    <p class="nn-subtitle animate-on-scroll" data-delay="0.05s">
      Arquitectura del MLPClassifier (mejor modelo). Hover para ver conexiones. Click en un nodo para simular la propagacion de senal hacia la salida.
    </p>

    <div class="nn-wrapper animate-on-scroll" data-delay="0.1s">
      <svg
        id="nnSvg"
        class="nn-svg"
        viewBox="0 0 1000 440"
        preserveAspectRatio="xMidYMid meet"
      >
        <!-- Connections drawn by JS -->
        <g id="nnEdges" class="nn-edges"></g>

        <!-- Layer labels -->
        <text x="200" y="22" class="layer-label">Input (13)</text>
        <text x="430" y="22" class="layer-label">Hidden 1 (64)</text>
        <text x="650" y="22" class="layer-label">Hidden 2 (32)</text>
        <text x="880" y="22" class="layer-label">Output (3)</text>

        <!-- Input nodes -->
        {inputNodes.map((name, i) => {
          const y = 55 + i * 38;
          return (
            <g class="nn-node input-node" data-layer="input" data-index={i}>
              <circle cx="200" cy={y} r="14" />
              <text x="200" y={y + 1} class="node-label">{i + 1}</text>
              <text x="120" y={y + 1} class="input-label">{name}</text>
            </g>
          );
        })}

        <!-- Hidden layer 1 -->
        {Array.from({ length: hiddenLayer1 }, (_, i) => {
          const y = 55 + i * 46;
          return (
            <g class="nn-node hidden-node" data-layer="h1" data-index={i}>
              <circle cx="430" cy={y} r="12" />
            </g>
          );
        })}

        <!-- Hidden layer 2 -->
        {Array.from({ length: hiddenLayer2 }, (_, i) => {
          const y = 90 + i * 52;
          return (
            <g class="nn-node hidden-node" data-layer="h2" data-index={i}>
              <circle cx="650" cy={y} r="12" />
            </g>
          );
        })}

        <!-- Output nodes -->
        {outputNodes.map((node, i) => {
          const y = 140 + i * 90;
          return (
            <g class="nn-node output-node" data-layer="output" data-index={i}>
              <circle cx="880" cy={y} r="22" style={`--node-color: ${node.color}`} />
              <text x="880" y={y + 1} class="node-label output-label">{node.label}</text>
            </g>
          );
        })}

        <!-- Architecture note -->
        <text x="500" y="430" class="arch-note">* Nodos representativos — arquitectura real: 13 → 64 → 32 → 3</text>
      </svg>
    </div>

    <div class="grid-3 nn-info">
      <div class="card nn-info-card animate-on-scroll" data-delay="0.2s">
        <span class="nn-info-title" style="color: var(--cyan)">Arquitectura</span>
        <p class="nn-info-text">13 → 64 → 32 → 3 neuronas. MLPClassifier con activacion ReLU, early stopping y StandardScaler.</p>
      </div>
      <div class="card nn-info-card animate-on-scroll" data-delay="0.28s">
        <span class="nn-info-title" style="color: var(--green)">Mejor Modelo: 60.00%</span>
        <p class="nn-info-text">Supero a Random Forest (58.33%). CV: 60.73% ± 1.12% confirma estabilidad.</p>
      </div>
      <div class="card nn-info-card animate-on-scroll" data-delay="0.36s">
        <span class="nn-info-title" style="color: var(--amber)">Ventaja</span>
        <p class="nn-info-text">Captura relaciones no lineales entre features sin feature engineering manual.</p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function() {
    var svg = document.getElementById("nnSvg");
    var edgesG = document.getElementById("nnEdges");
    if (!svg || !edgesG) return;

    var layers = [
      { x: 200, count: 10, startY: 55, gap: 38 },
      { x: 430, count: 8,  startY: 55, gap: 46 },
      { x: 650, count: 6,  startY: 90, gap: 52 },
      { x: 880, count: 3,  startY: 140, gap: 90 },
    ];

    function getY(l, idx) {
      return layers[l].startY + idx * layers[l].gap;
    }

    // Draw edges
    for (var l = 0; l < layers.length - 1; l++) {
      for (var i = 0; i < layers[l].count; i++) {
        for (var j = 0; j < layers[l + 1].count; j++) {
          var line = document.createElementNS("http://www.w3.org/2000/svg", "line");
          line.setAttribute("x1", layers[l].x);
          line.setAttribute("y1", getY(l, i));
          line.setAttribute("x2", layers[l + 1].x);
          line.setAttribute("y2", getY(l + 1, j));
          line.dataset.fromLayer = l;
          line.dataset.fromIdx = i;
          line.dataset.toLayer = l + 1;
          line.dataset.toIdx = j;
          edgesG.appendChild(line);
        }
      }
    }

    // Interaction: hover + click-to-lock path
    var allNodes = svg.querySelectorAll(".nn-node");
    var allEdges = edgesG.querySelectorAll("line");
    var lockedPath = null; // { inputIdx, path: [h1Idx, h2Idx, outputIdx] }

    function clearAll() {
      allEdges.forEach(function(e) { e.classList.remove("active"); e.classList.remove("path"); });
      allNodes.forEach(function(n) { n.classList.remove("active"); n.classList.remove("path-node"); });
    }

    function highlightNode(layerIdx, nodeIdx) {
      allEdges.forEach(function(edge) {
        var fL = parseInt(edge.dataset.fromLayer);
        var fI = parseInt(edge.dataset.fromIdx);
        var tL = parseInt(edge.dataset.toLayer);
        var tI = parseInt(edge.dataset.toIdx);
        if ((fL === layerIdx && fI === nodeIdx) || (tL === layerIdx && tI === nodeIdx)) {
          edge.classList.add("active");
        }
      });
    }

    // Generate a random path from input to output
    function generatePath(inputIdx) {
      var h1 = Math.floor(Math.random() * layers[1].count);
      var h2 = Math.floor(Math.random() * layers[2].count);
      var out = Math.floor(Math.random() * layers[3].count);
      return { inputIdx: inputIdx, nodes: [h1, h2, out] };
    }

    function showPath(path) {
      clearAll();
      // Highlight the full path edges
      var chain = [
        { layer: 0, idx: path.inputIdx },
        { layer: 1, idx: path.nodes[0] },
        { layer: 2, idx: path.nodes[1] },
        { layer: 3, idx: path.nodes[2] },
      ];

      for (var s = 0; s < chain.length - 1; s++) {
        allEdges.forEach(function(edge) {
          var fL = parseInt(edge.dataset.fromLayer);
          var fI = parseInt(edge.dataset.fromIdx);
          var tL = parseInt(edge.dataset.toLayer);
          var tI = parseInt(edge.dataset.toIdx);
          if (fL === chain[s].layer && fI === chain[s].idx &&
              tL === chain[s + 1].layer && tI === chain[s + 1].idx) {
            edge.classList.add("path");
          }
        });
      }

      // Highlight path nodes
      var layerNames = ["input", "h1", "h2", "output"];
      chain.forEach(function(c) {
        allNodes.forEach(function(n) {
          if (n.dataset.layer === layerNames[c.layer] && parseInt(n.dataset.index) === c.idx) {
            n.classList.add("path-node");
          }
        });
      });
    }

    // Hover: highlight connected edges (only if no locked path)
    allNodes.forEach(function(node) {
      node.addEventListener("mouseenter", function() {
        if (lockedPath) return;
        var layerMap = { input: 0, h1: 1, h2: 2, output: 3 };
        var layerIdx = layerMap[node.dataset.layer];
        var nodeIdx = parseInt(node.dataset.index);
        highlightNode(layerIdx, nodeIdx);
        node.classList.add("active");
      });

      node.addEventListener("mouseleave", function() {
        if (lockedPath) return;
        clearAll();
      });

      // Click: lock a full path from input → hidden1 → hidden2 → output
      node.addEventListener("click", function() {
        var layerMap = { input: 0, h1: 1, h2: 2, output: 3 };
        var layerIdx = layerMap[node.dataset.layer];
        var nodeIdx = parseInt(node.dataset.index);

        // If clicking same locked input, unlock
        if (lockedPath && layerIdx === 0 && lockedPath.inputIdx === nodeIdx) {
          lockedPath = null;
          clearAll();
          return;
        }

        // Generate path from clicked node (any layer starts from an input)
        var inputIdx = layerIdx === 0 ? nodeIdx : Math.floor(Math.random() * layers[0].count);
        lockedPath = generatePath(inputIdx);
        showPath(lockedPath);
      });
    });

    // Click on background to unlock
    svg.addEventListener("click", function(e) {
      if (e.target === svg || e.target.tagName === "svg") {
        lockedPath = null;
        clearAll();
      }
    });

    // Staggered appear
    var d = 0;
    allNodes.forEach(function(n) {
      setTimeout(function() { n.classList.add("appeared"); }, d);
      d += 30;
    });
  });
</script>

<style is:global>
  .section {
    padding: 3rem 0;
  }

  .nn-subtitle {
    font-size: 0.9rem;
    color: var(--muted);
    margin-top: -1.5rem;
    margin-bottom: 2rem;
    padding-left: 1rem;
  }

  .nn-wrapper {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem 1rem;
    overflow-x: auto;
  }

  .nn-svg {
    width: 100%;
    min-width: 700px;
    max-height: 460px;
  }

  .layer-label {
    fill: var(--muted);
    font-size: 10px;
    font-family: var(--font-display);
    font-weight: 600;
    text-anchor: middle;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .nn-edges line {
    stroke: rgba(255, 255, 255, 0.07);
    stroke-width: 0.7;
    transition: stroke 0.2s, stroke-width 0.2s, filter 0.2s;
  }

  .nn-edges line.active {
    stroke: #00f0ff;
    stroke-width: 2;
    filter: drop-shadow(0 0 4px rgba(0, 240, 255, 0.5));
  }

  .nn-edges line.path {
    stroke: #00f0ff;
    stroke-width: 3;
    filter: drop-shadow(0 0 6px rgba(0, 240, 255, 0.6));
    animation: pulseEdge 1.5s ease-in-out infinite;
  }

  @keyframes pulseEdge {
    0%, 100% { stroke-opacity: 1; }
    50% { stroke-opacity: 0.5; }
  }

  .nn-node.path-node circle {
    stroke: #00f0ff;
    fill: rgba(0, 240, 255, 0.15);
    filter: drop-shadow(0 0 8px rgba(0, 240, 255, 0.5));
    stroke-width: 2.5;
  }

  .output-node.path-node circle {
    fill: rgba(0, 240, 255, 0.1);
    filter: drop-shadow(0 0 10px var(--node-color));
  }

  .nn-node {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .nn-node.appeared {
    opacity: 1;
  }

  .nn-node circle {
    fill: #0a0a0f;
    stroke: rgba(136, 136, 136, 0.5);
    stroke-width: 1.5;
    transition: stroke 0.2s, fill 0.2s, filter 0.2s;
    cursor: pointer;
  }

  .nn-node.active circle,
  .nn-node:hover circle {
    stroke: #00f0ff;
    fill: rgba(0, 240, 255, 0.1);
    filter: drop-shadow(0 0 6px rgba(0, 240, 255, 0.35));
  }

  .output-node circle {
    stroke: var(--node-color, var(--muted));
    stroke-width: 2.5;
  }

  .output-node.active circle,
  .output-node:hover circle {
    stroke: var(--node-color);
    fill: color-mix(in srgb, var(--node-color) 15%, var(--bg));
    filter: drop-shadow(0 0 8px var(--node-color));
  }

  .node-label {
    fill: var(--muted);
    font-size: 8px;
    font-family: var(--font-mono);
    text-anchor: middle;
    dominant-baseline: central;
    pointer-events: none;
  }

  .output-label {
    fill: var(--text);
    font-size: 10px;
    font-family: var(--font-display);
    font-weight: 700;
  }

  .input-label {
    fill: var(--muted);
    font-size: 8px;
    font-family: var(--font-mono);
    text-anchor: end;
    dominant-baseline: central;
  }

  .arch-note {
    fill: var(--muted);
    font-size: 9px;
    font-family: var(--font-mono);
    text-anchor: middle;
    opacity: 0.6;
  }

  .nn-info {
    margin-top: 1.5rem;
  }

  .nn-info-card {
    padding: 1rem 1.25rem;
  }

  .nn-info-title {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    display: block;
    margin-bottom: 0.35rem;
  }

  .nn-info-text {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.55;
  }

  @media (max-width: 768px) {
    .nn-svg {
      min-width: 600px;
    }

    .input-label {
      display: none;
    }
  }
</style>
