---
const metrics = [
  {
    name: "Accuracy",
    value: "60.00%",
    baseline: "33.33%",
    color: "var(--cyan)",
    desc: "Metrica principal. Comparada contra baseline aleatorio de 3 clases.",
  },
  {
    name: "F1-Score",
    value: "macro / weighted",
    baseline: null,
    color: "var(--amber)",
    desc: "Pondera precision y recall. Importante por el desbalance de clases.",
  },
  {
    name: "Precision (Alto)",
    value: "1.00",
    baseline: null,
    color: "var(--green)",
    desc: "Cuando predice Alto, acierta. Pero lo predice casi nunca (recall 0.02).",
  },
  {
    name: "Recall (Alto)",
    value: "0.02",
    baseline: null,
    color: "var(--red)",
    desc: "No queremos pasar por alto adolescentes en riesgo. Este valor es critico.",
  },
  {
    name: "Cross-Validation",
    value: "5-fold",
    baseline: null,
    color: "var(--cyan)",
    desc: "Evalua que el modelo no este sobreajustado. MLP: 60.73% CV vs 60.00% test.",
  },
  {
    name: "Matriz de Confusion",
    value: "3x3",
    baseline: null,
    color: "var(--muted)",
    desc: "Visualiza donde se confunde el modelo entre las 3 clases.",
  },
];
---

<section id="metricas" class="section">
  <div class="container">
    <h2 class="section-title animate-on-scroll">Metricas de Evaluacion</h2>
    <p class="section-desc animate-on-scroll" data-delay="0.05s">¿Por que estas metricas y no otras?</p>

    <div class="grid-3">
      {metrics.map((m, i) => (
        <div class="card metric-card animate-on-scroll" data-delay={`${i * 0.08}s`}>
          <div class="metric-header">
            <span class="metric-name" style={`color: ${m.color}`}>{m.name}</span>
            <span class="metric-value" style={`color: ${m.color}`}>{m.value}</span>
          </div>
          {m.baseline && (
            <span class="metric-baseline">Baseline: {m.baseline}</span>
          )}
          <p class="metric-desc">{m.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section {
    padding: 3rem 0;
  }

  .section-desc {
    font-size: 0.95rem;
    color: var(--muted);
    margin-top: -1.5rem;
    margin-bottom: 2rem;
    padding-left: 1rem;
  }

  .metric-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .metric-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .metric-name {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .metric-value {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    opacity: 0.8;
  }

  .metric-baseline {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }

  .metric-desc {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.55;
  }
</style>
